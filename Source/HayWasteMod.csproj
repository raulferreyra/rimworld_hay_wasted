<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>../Assemblies/</OutputPath>
    <RootNamespace>HayWasteMod</RootNamespace>
    <AssemblyName>HayWasteMod</AssemblyName>
    <LangVersion>latest</LangVersion>

    <!-- Auto-detect RimWorld installation path -->
    <!-- Priority: Environment variable > Direct path calculation -->
    <RimWorldInstallPath Condition="'$(RimWorldInstallPath)' == ''">
      $([System.Environment]::GetEnvironmentVariable('RIMWORLD_INSTALL_PATH'))</RimWorldInstallPath>
    <!-- If not set, calculate: Source/../../../ = RimWorld root -->
    <RimWorldInstallPath Condition="'$(RimWorldInstallPath)' == ''">
      $([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine($(MSBuildThisFileDirectory), '..\..\..'))))
    </RimWorldInstallPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>F:\SteamLibrary\steamapps\common\RimWorld\RimWorldWin64_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>F:\SteamLibrary\steamapps\common\RimWorld\RimWorldWin64_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.2.2" />
  </ItemGroup>

</Project>