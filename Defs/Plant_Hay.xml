<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Hay Item Definition -->
  <ThingDef>
    <defName>Hay_Waste</defName>
    <label>hay</label>
    <description>Nutrient-rich grasses and shoots, harvested and compacted for storage. Hay is good animal feed, but inedible for humans. Generated as a byproduct from harvesting crops inversely to yield success.</description>
    <graphicData>
      <texPath>Things/Item/Resource/Hay</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <pathCost>14</pathCost>
    <useHitPoints>false</useHitPoints>
    <statBases>
      <Mass>0.02</Mass>
      <Flammability>1.0</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>AnimalFeed</li>
    </thingCategories>
    <stackLimit>999</stackLimit>
    <ingestible>
      <foodType>Plant</foodType>
      <nutrition>0.3</nutrition>
      <preferability>RawBad</preferability>
    </ingestible>
  </ThingDef>

</Defs>