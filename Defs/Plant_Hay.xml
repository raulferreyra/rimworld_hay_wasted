<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Hay Item Definition - Byproduct from Harvest -->
  <ThingDef>
    <defName>Hay_Waste</defName>
    <label>hay</label>
    <description>Nutrient-rich grasses and shoots, harvested as a byproduct. Good animal feed but inedible for humans.</description>
    <graphicData>
      <texPath>Things/Item/Resource/RawPlant</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <pathCost>14</pathCost>
    <useHitPoints>true</useHitPoints>
    <maxHitPoints>60</maxHitPoints>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <Mass>0.02</Mass>
      <Flammability>0.6</Flammability>
      <DeteriorationRate>1</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>PlantMatter</li>
    </thingCategories>
    <drawGUIOverlay>true</drawGUIOverlay>
    <stackLimit>999</stackLimit>
    <ingestible>
      <foodType>Plant</foodType>
      <preferability>RawBad</preferability>
    </ingestible>
  </ThingDef>

</Defs>