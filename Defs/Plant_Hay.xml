<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Hay Item Definition - Byproduct from Harvest -->
  <ThingDef>
    <defName>Hay_Waste</defName>
    <label>hay</label>
    <description>Nutrient-rich grasses and shoots, harvested as a byproduct from crops. Good animal feed but inedible for humans.</description>
    <graphicData>
      <texPath>Things/Item/Food/RawVegetarian</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <pathCost>14</pathCost>
    <statBases>
      <Mass>0.02</Mass>
    </statBases>
    <stackLimit>999</stackLimit>
    <drawGUIOverlay>true</drawGUIOverlay>
    <ingestible>
      <preferability>NeverForNutrition</preferability>
      <foodType>Plant</foodType>
    </ingestible>
  </ThingDef>

</Defs>